{
  "name": "minimi-chat-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A fast, honest chat agent with one tool (web search) and a timeline memory of everything you asked and when.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "chrono-node": "^2.10.3",
    "dotenv": "^18.0.10",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
