# Required. The only API key this agent needs: Claude does the reasoning AND the
# web search (Anthropic's server-side web_search tool), so there is no separate
# search-provider key.
ANTHROPIC_API_KEY=

# Optional (defaults shown)
# MODEL=claude-opus-5-5
# EFFORT=medium            # low | medium | high — trades depth for latency
# PORT=3000
# DATA_DIR=./data          # where the per-user conversation timeline is stored
# AGENT_NOW=               # e.g. 2026-11-03T10:00:00Z — pretend the clock starts here (to build up dated history for testing)
